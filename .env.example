# =============================================================================
# CCTV-Streamer Enterprise Configuration (.env.example)
# Copy this file to .env and replace placeholder values before deployment.
# NEVER commit your actual .env file to version control.
# =============================================================================

# --- Global & Security Settings ---
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
API_SECRET_KEY=change-me-to-a-64-char-cryptographic-hex-secret-key
INTERNAL_SERVICE_TOKEN=change-me-internal-microservice-shared-token
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOW_PRIVATE_NETWORKS=true

# --- Camera Discovery Microservice ---
DISCOVERY_HOST=0.0.0.0
DISCOVERY_PORT=8001
DISCOVERY_SUBNETS=192.168.1.0/24,10.0.0.0/24
DISCOVERY_PORTS=554,8554,80,8000,8080,8899
DISCOVERY_SCAN_INTERVAL_SEC=300
DISCOVERY_SOCKET_TIMEOUT_SEC=1.2
DISCOVERY_MAX_WORKERS=64
ONVIF_MULTICAST_HOST=239.255.255.250
ONVIF_MULTICAST_PORT=3702
ONVIF_DISCOVERY_TIMEOUT_SEC=3.0

# --- Default Camera / ONVIF Credentials (Injected via Environment) ---
ONVIF_USERNAME=admin
ONVIF_PASSWORD=change-me-onvif-password
RTSP_DEFAULT_USERNAME=admin
RTSP_DEFAULT_PASSWORD=change-me-rtsp-password

# --- Video Stream Transcoding Microservice ---
TRANSCODER_HOST=0.0.0.0
TRANSCODER_PORT=8002
RTSP_TRANSPORT=tcp
STREAM_TARGET_FPS=20
STREAM_JPEG_QUALITY=80
STREAM_FRAME_WIDTH=1280
STREAM_FRAME_HEIGHT=720
STREAM_BUFFER_SIZE=2
STREAM_READ_TIMEOUT_SEC=8.0
STREAM_RECONNECT_BASE_DELAY_SEC=1.0
STREAM_RECONNECT_MAX_DELAY_SEC=30.0
STREAM_RECONNECT_MAX_ATTEMPTS=0
ENABLE_DEMO_STREAMS=true

# --- Data Processing & Video Analytics Microservice ---
PROCESSOR_HOST=0.0.0.0
PROCESSOR_PORT=8003
PROCESSOR_SAMPLE_INTERVAL_SEC=0.5
MOTION_SENSITIVITY_THRESHOLD=500.0
MOTION_MIN_CONTOUR_AREA=450
TAMPER_DARKNESS_THRESHOLD=18.0
TAMPER_VARIANCE_THRESHOLD=5.0
EVENT_COOLDOWN_SEC=5.0
MAX_STORED_EVENTS=1000

# --- Gateway & Control Room Console ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
DISCOVERY_SERVICE_URL=http://discovery:8001
TRANSCODER_SERVICE_URL=http://transcoder:8002
PROCESSOR_SERVICE_URL=http://processor:8003
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
REDIS_PASSWORD=change-me-redis-password
